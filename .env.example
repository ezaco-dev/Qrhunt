# =============================================================================
# QrHunt — contoh environment
#
#   cp .env.example .env.local
#
# ATURAN: prefix `NEXT_PUBLIC_` berarti nilainya MASUK ke bundle browser dan
# bisa dibaca siapa pun yang membuka DevTools. JANGAN pernah memberi prefix itu
# pada sebuah secret. Kalau ragu, tidak ada prefix — lebih baik repot daripada
# membocorkan kunci API.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (wajib)
# -----------------------------------------------------------------------------

# Publik — muncul di bundle browser, aman karena memang untuk sisi klien.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# ⚠️ RAHASIA. Service role MEMBYPASS Row Level Security. Jangan pernah diberi
# prefix NEXT_PUBLIC_ dan jangan pernah dikirim ke browser.
# Settings → API → secret key.
#
# Dua generasi kunci, keduanya diterima oleh kode ini apa adanya:
#   - proyek lama: JWT `service_role` yang diawali "eyJ..."
#   - proyek baru: `sb_secret_...`
# Yang wajib hanya satu baris di bawah ini, pilih mana yang ada di dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# Opsional. Hanya dibaca `getSupabaseBrowserClient()`, yang saat ini belum
# dipakai komponen mana pun (lihat AGENTS.md bagian "Batasan").
#
# Nama variabel juga punya dua generasi, dan KEDUA-duanya diterima:
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   (dashboard baru)
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...                     (proyek lama)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Cloudinary (wajib untuk unggah gambar/GIF/video)
# -----------------------------------------------------------------------------
# Kalau kosong, `/api/upload` membalas 502 dengan kode `cloudinary`.
# Media TEKS tetap berfungsi tanpa ini.
#
# ⚠️ API SECRET ADA DI DALAM URL DI BAWAH. Jangan pernah menempelkan nilai ini
# ke chat, commit, screenshot, atau/issues publik. Kalau bocor, reset lewat
# console Cloudinary (Settings → API Keys), lalu perbarui di sini.
#
# Dua cara, pilih SATU saja. Kalau `CLOUDINARY_URL` terisi, tiga baris di
# bawahnya diabaikan.

CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Alternatif — pisahkan nilainya:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Layanan moderasi di VPS (wajib untuk produksi)
# -----------------------------------------------------------------------------
# ⚠️ RAHSIA. Kunci ini otoritasi aplikasi Next.js di Vercel untuk memanggil
# layanan moderasi. Siapa pun yang memilikinya bisa memakai server ini, jadi
# jangan pernah menempelkannya ke chat, commit, screenshot, atau issue publik.
#
# Moderasi di browser (NSFWJS) bisa dilewati, jadi pemeriksaan server inilah yang
# menentukan. Kalau kosong, unggahan DITOLAK dengan 503, bukan diloloskan.
#
# `MODERATION_SERVICE_URL` WAJIB https:// kecuali menunjuk ke loopback
# (127.0.0.1/localhost). Tanpa TLS, kunci dan isi unggahan bisa dibaca orang
# di tengah, dan orang itu lalu bisa memalsukan jawaban moderasi.
#
# Nilai produksi menunjuk ke IP VPS, bukan subdomain. Domain ini tidak punya
# wildcard, jadi subdomain moderasi memang tidak pernah dibuat dan Let's
# Encrypt tidak bisa menerbitkan sertifikat untuk nama itu. Supaya tidak
# menunggu record DNS, Caddy melayani IP-nya dengan sertifikat self-signed khusus.
#
# Karena sertifikatnya self-signed, ia TIDAK dikenal system trust store mana
# pun. Klien hanya menerimanya lewat `MODERATION_CA_PEM`, jadi untuk URL
# https non-loopback keduanya harus terisi bersamaan. Nilai produksi:
#
#   MODERATION_SERVICE_URL=https://103.210.69.31
#   MODERATION_CA_PEM=<base64 -w0 /etc/caddy/certs/qrhunt-ip.crt>
#
# Kalau https non-loopback diisi tanpa `MODERATION_CA_PEM`, unggahan ditolak
# 503, bukan diloloskan. Ganti sertifikat di VPS berarti mengganti env ini juga.
#
# Kunci yang sama harus diisi di VPS saat menjalankan `moderation-service/`.

MODERATION_SERVICE_URL=http://127.0.0.1:8787
MODERATION_API_KEY=
# Opsional, tapi WAJIB untuk https:// non-loopback. Menerima PEM multiline
# atau base64 dari PEM itu. Tidak diperlukan untuk loopback.
MODERATION_CA_PEM=
# Harus lebih kecil dari maxDuration route (60 detik di app/api/upload/route.ts).
# Inferensi VPS ~2,5 detik per frame dan video dinilai sampai 8 frame, jadi 8 detik
# membuat video yang sah selalu ditolak.
MODERATION_TIMEOUT_MS=45000

# Ambang skor eksplisit yang dipakai layanan moderasi di VPS. Hanya dibaca
# oleh `moderation-service/server.mjs`, TIDAK oleh aplikasi Next.js, jadi
# mengubahnya di sini tidak berpengaruh apa pun sampai juga diubah di VPS.
MODERATION_THRESHOLD=0.6

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (opsional, sangat disarankan untuk produksi)
# -----------------------------------------------------------------------------
# Tanpa ini, verifikasi anti-bot dilewati dengan mode placeholder dan
# `/api/upload` tidak punya perlindungan bot sama sekali.

# Publik — masuk ke bundle browser. Wajib ada agar widget ditampilkan.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ⚠️ RAHASIA.
TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Admin (development)
# -----------------------------------------------------------------------------
# Password admin untuk /admin dan /admin/login. Satu user, tanpa multi-role.
# Kalau kosong, login DITOLAK, bukan diterima dengan password apa pun.

ADMIN_PASSWORD=
# Kunci HMAC untuk cookie sesi admin (httpOnly, 12 jam). Buat dengan
# `openssl rand -hex 32`. Mengganti nilainya membatalkan semua sesi yang jalan.
ADMIN_SESSION_SECRET=

# -----------------------------------------------------------------------------
# Google AdSense
# -----------------------------------------------------------------------------
# Opsional. Unit iklan Display. Tanpa `slot` unit tidak dirender; tanpa
# `NEXT_PUBLIC_ADSENSE_CLIENT` dipakai fallback bawaan di kode.
#
# Publik — keduanya memang untuk sisi klien (bukan secret).
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-8488653214573915
# Slot ID dari dashboard AdSense → Ads → Display ads (mis. "1234567890").
NEXT_PUBLIC_ADSENSE_SLOT_MODAL=
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=

# -----------------------------------------------------------------------------
# Batas & perilaku
# -----------------------------------------------------------------------------

# Opsional. Durasi modal iklan, detik. Default: 20. Nilai di luar 1..60 diabaikan.
NEXT_PUBLIC_AD_DURATION_SECONDS=20

# Opsional. Ambang moderasi browser (NSFWJS). Default: 0.6.
# ⚠️ Ini hanya memengaruhi UX. Mengubahnya TIDAK mengubah moderasi server —
# pengaturnya `MODERATION_THRESHOLD`, dan itu hanya dibaca di VPS.
NEXT_PUBLIC_NSFW_THRESHOLD=0.6

# Opsional. Jumlah laporan sebelum media otomatis disembunyikan. Default: 3.
# Nilai di bawah 1 diabaikan.
REPORT_HIDE_THRESHOLD=3